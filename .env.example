# kweeks-server runtime configuration.
# Copy this file to .env and fill in your values. Real environment variables
# always take precedence over this file.

# --- Environment & HTTP ---
KWEEKS_ENV=development
KWEEKS_HTTP_ADDR=:8080

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgres://kweeks:kweeks@localhost:5432/kweeks

# --- BMONI Embedded API ---
# Base URL. embedded-dev = sandbox; embedded = production.
BMONI_BASE_URL=https://embedded-dev.bmoni.com
BMONI_API_KEY=
# Hex secp256k1 private key (no 0x) for the instructor owner wallet that
# signs prize transfers.
BMONI_OWNER_KEY=
BMONI_INSTRUCTOR_USER_ID=
# Optional explicit recipient wallet for sandbox sends.
BMONI_WALLET_ID=

# --- BMONI onboarding persona (NGN rail) ---
# Sandbox identity look-ups only resolve the documented test personas; use one
# verbatim (e.g. Samson Jabo: BVN 22222222222, phone +2348000000001). Real
# signups fall back to the local ledger when this is empty.
BMONI_PERSONA_FIRST_NAME=
BMONI_PERSONA_LAST_NAME=
BMONI_PERSONA_EMAIL=
BMONI_PERSONA_PHONE=
BMONI_PERSONA_BVN=
BMONI_PERSONA_DOB=1990-01-15
BMONI_PERSONA_ADDRESS=15 Admiralty Way
BMONI_PERSONA_CITY=Lagos
BMONI_PERSONA_STATE=Lagos
# Operator KYC document images (JPEG/PNG) to upload during provisioning. Leave
# empty to stop before the document step (rail stays pending verification).
BMONI_DOC_IDENTIFICATION=
BMONI_DOC_PROOF_OF_ADDRESS=
BMONI_DOC_BIOMETRIC=
# When true, signup also provisions a real BMONI user + CNGN wallet (needs the
# persona + owner key above). Failures never block signup.
BMONI_PROVISION_ON_SIGNUP=false

# --- Email (redemption recovery only; never the critical path) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=kweeks@example.com
# Second sandbox persona that receives prize money at the podium (winner).
BMONI_WINNER_USER_ID=
