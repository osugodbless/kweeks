# kweeks-server runtime configuration.
# Copy this file to .env and fill in your values. Real environment variables
# always take precedence over this file.

# --- Environment & HTTP ---
KWEEKS_ENV=development
KWEEKS_HTTP_ADDR=:8080
# External origin used to build the /claim link in redemption emails.
KWEEKS_PUBLIC_URL=http://localhost:8080
# Serve the built SPA (web/dist) from the same origin as /api.
KWEEKS_WEB_ROOT=web/dist

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgres://kweeks:kweeks@localhost:5432/kweeks

# --- BMONI Embedded API ---
# Base URL. embedded-dev = sandbox; embedded = production.
BMONI_BASE_URL=https://embedded-dev.bmoni.com
BMONI_API_KEY=pk_...
# Hex secp256k1 private key (no 0x) that signs owner-proof challenges and
# proposal digests for every provisioned host wallet.
BMONI_OWNER_KEY=...

# --- BMONI sandbox persona (NGN rail) ---
# The sandbox resolves a fixed persona set; these values are used verbatim so
# KYC verification matches. In production, configure the identity that opens
# each host wallet. Phone is E.164.
BMONI_PERSONA_FIRST_NAME=Bunch
BMONI_PERSONA_LAST_NAME=Dillon
BMONI_PERSONA_EMAIL=bunch.dillon@example.com
BMONI_PERSONA_PHONE=+2348000000000
BMONI_PERSONA_BVN=95888168924
BMONI_PERSONA_DOB=1990-01-15
BMONI_PERSONA_ADDRESS=15 Admiralty Way
BMONI_PERSONA_CITY=Lagos
BMONI_PERSONA_STATE=Lagos
# Provision a real BMONI user + CNGN wallet + NGN rail at instructor signup.
BMONI_PROVISION_ON_SIGNUP=true

# --- Email (redemption recovery only; never the critical path) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=app-password
SMTP_FROM=you@gmail.com
